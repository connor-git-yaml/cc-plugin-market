{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixComplianceVerdictEvent",
  "description": "写入 .specify/runs/YYYY-MM.jsonl 的新增审计事件类型，与既有 workflow-run-summary 事件共存于同一月度文件。仅在不合规（block/warn）或判定异常/降级放行时写入；合规放行不写入。",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventType",
    "recordedAt",
    "sessionId",
    "enforcement",
    "closureForm",
    "compliant",
    "missing",
    "degraded",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "eventType": { "type": "string", "const": "fix-compliance-verdict" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "sessionId": { "type": "string", "minLength": 1 },
    "enforcement": { "type": "string", "enum": ["block", "warn"] },
    "closureForm": { "type": "string", "enum": ["repair", "no-op", "undetermined"] },
    "compliant": {
      "type": ["boolean", "null"],
      "description": "null 表示 FR-013 fail-open 场景——判定过程异常导致未能得出合规结论，仅携带 diagnostics 落盘"
    },
    "missing": { "type": "array", "items": { "type": "string" } },
    "blockCount": { "type": ["integer", "null"], "description": "本次判定所处的阻断计数；warn 档恒为 null，block 档在「在途推迟」分支（diagnostics 含 delegation-in-flight）亦为 null——推迟不消耗阻断预算，此时无计数可报；存储不可用阻断分支亦为 null（预算不可知）" },
    "degraded": { "type": "boolean", "description": "true 表示本次为达到阻断上限后的降级放行" },
    "diagnostics": {
      "type": "array",
      "description": "F276 卡 C 残余登记：三个 nonblock-* 码当前「已登记但零产出」——其产出方（解锁计时器路由）自始生产零接线，已随卡 C 删除，递增方留给卡 B 接线时重建。刻意保留登记以免卡 B 再加回造成合同 churn；本仓亦刻意不加「enum ⊆ 已产出码」的全局反向守卫（那属卡 A 的 canonical 表范围），否则此三码会立即自伤。",
      "items": {
        "type": "string",
        "enum": [
          "transcript-unavailable",
          "transcript-empty",
          "in-flight-detected",
          "in-flight-none",
          "in-flight-undetermined",
          "stop-hook-reentry",
          "nonblock-limit-exhausted",
          "nonblock-backstop-exhausted",
          "nonblock-storage-unavailable",
          "ledger-entry-conflict",
          "ledger-window-undetermined",
          "ledger-supplemented-role",
          "ledger-agent-id-inversion-suspected",
          "transcript-too-large",
          "parse-timeout",
          "internal-error",
          "config-degraded",
          "state-storage-unavailable",
          "payload-invalid",
          "feature-dir-unresolvable",
          "feature-dir-witness-absent",
          "transcript-path-absent",
          "transcript-format-unrecognized",
          "dialect:codex-rollout",
          "delegation-in-flight",
          "delegation-in-flight-budget-exhausted",
          "delegation-in-flight-entry-budget-exhausted",
          "storage-unavailable-block-budget-exhausted"
        ]
      }
    }
  },
  "additionalProperties": false
}
